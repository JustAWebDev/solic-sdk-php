{
    "name": "justawebdev/solic-sdk-php",
    "description": "An SDK for the Solic Service",
    "homepage": "https://github.com/JustAWebDev/solic-sdk-php",
    "type": "library",
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^7.15.2",
        "jenssegers/blade": "^1.4"
    },
    "conflict": {
        "guzzlehttp/psr7": "<2.12.3",
        "nesbot/carbon": "<2.72.6 || >=3.0.0 <3.8.4",
        "illuminate/view": "<6.20.42 || >=7.0.0 <7.30.6 || >=8.0.0 <8.75.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Solic\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Solic\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Justin Thomas"
        }
    ],
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
